extend type Query {
  textract: TextractQuery!
}

type TextractQuery {
  """List all jobs the current user owns.
  """
  listJobs: [TextractJob!]!

  jobById(id: ID!): TextractJob!
}

extend type Mutation {
  textract: TextractMutation!
}

type TextractMutation {
  """Create a new job from a pre-uploaded file. Use the `profile.scratchFile`
  field to obtain a pre-signed upload URL, and pass its filename here when done.
  """
  createPreUploadedJob(filename: String!): TextractJob!
  """Re-request a failed job. The job must be retryable.
  """
  retryJob(id: ID!): TextractJob!
  deleteJob(id: ID!): Deletion!
}

enum TextractJobStatus {
  PENDING
  READY
  ERROR
}

type TextractJob {
  id: ID!
  photo: FileInfo!
  status: TextractJobStatus!
  """Whether 'status' is READY. Prefer `status`.
  """
  ready: Boolean!
  """Why extraction failed. Will only have data if 'status' is ERROR.
  """
  errorMessage: String
  """Whether `retryJob` will accept this job.
  """
  retryable: Boolean!
  """Lines of extracted text. Will only have data if 'status' is READY.
  """
  lines: [TextractLine!]
}

type FileInfo {
  url: String!
  contentType: String!
  size: NonNegativeInt!
  filename: String!
}

type TextractLine {
  text: String!
  box: TextractBox!
}

type TextractBox {
  left: NonNegativeFloat!
  top: NonNegativeFloat!
  width: NonNegativeFloat!
  height: NonNegativeFloat!
}
