scalar Date
scalar DateTime
scalar Long
scalar PositiveInt
scalar NonNegativeInt
scalar NonNegativeFloat
"""The type of a cursor, an opaque string used for walking connections.
"""
scalar Cursor

schema {
    query: Query
    mutation: Mutation
}

type Query {
    node(id: ID!): Node
}

type Mutation {
}

interface Node {
    id: ID!
}

type PageInfo {
    """Whether this connection has a previous page.
    """
    hasPreviousPage: Boolean!
    """Whether this connection has a next page.
    """
    hasNextPage: Boolean!
    """The first cursor returned in this page's edges.
    """
    startCursor: Cursor
    """The last cursor returned in this page's edges.
    """
    endCursor: Cursor
}

type ShareInfo {
    id: ID!
    slug: String!
    secret: String!
}

type Deletion {
    id: ID!
    name: String
}
